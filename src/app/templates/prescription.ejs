
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>Your Prescription Is Ready | Life Hospital</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #172b4d;
      -webkit-font-smoothing: antialiased;
    }

    table {
      border-collapse: collapse;
    }

    img {
      border: 0;
      display: block;
    }

    @media only screen and (max-width: 620px) {
      .email-container {
        width: 100% !important;
      }

      .mobile-padding {
        padding-left: 20px !important;
        padding-right: 20px !important;
      }

      .mobile-title {
        font-size: 25px !important;
      }

      .mobile-column {
        display: block !important;
        width: 100% !important;
      }

      .mobile-button {
        display: block !important;
        text-align: center !important;
      }
    }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#f4f7fb;">

  <!-- Preheader -->
  <div style="display:none;font-size:1px;color:#f4f7fb;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">
    Your doctor has issued a new prescription. View your prescription securely.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
    border="0" style="background-color:#f4f7fb;padding:35px 12px;">

    <tr>
      <td align="center">

        <table role="presentation" class="email-container"
          width="600" cellpadding="0" cellspacing="0" border="0"
          style="max-width:600px;width:100%;background-color:#ffffff;border-radius:16px;overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="background-color:#155eef;background-image:linear-gradient(135deg,#155eef 0%,#1949b8 100%);padding:30px 36px;">

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td>
                    <p style="margin:0;color:#dbeafe;font-size:13px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;">
                      Life Hospital
                    </p>
                  </td>
                  <td align="right">
                    <span style="display:inline-block;background-color:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);border-radius:20px;padding:7px 12px;color:#ffffff;font-size:11px;font-weight:bold;">
                      HEALTHCARE NOTIFICATION
                    </span>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding-top:35px;">

                    <p style="margin:0 0 12px;color:#bfdbfe;font-size:13px;font-weight:bold;letter-spacing:1px;">
                      YOUR HEALTHCARE UPDATE
                    </p>

                    <h1 class="mobile-title"
                      style="margin:0;color:#ffffff;font-size:32px;line-height:1.25;font-weight:bold;">
                      Your prescription<br />is ready.
                    </h1>

                    <p style="margin:15px 0 0;color:#e0ebff;font-size:14px;line-height:1.8;">
                      Your doctor has prepared a new prescription
                      following your recent consultation.
                    </p>

                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Main content -->
          <tr>
            <td class="mobile-padding" style="padding:36px;">

              <!-- Greeting -->
              <p style="margin:0 0 10px;color:#172b4d;font-size:17px;line-height:1.6;">
                Hello <strong><%= patientName %></strong>,
              </p>

              <p style="margin:0 0 25px;color:#667085;font-size:14px;line-height:1.8;">
                Your prescription is now available. You can review
                the details below and access your prescription PDF
                using the secure link.
              </p>

              <!-- Status -->
              <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                style="margin-bottom:28px;">
                <tr>
                  <td style="background-color:#ecfdf3;border:1px solid #abefc6;border-radius:30px;padding:9px 15px;">
                    <span style="color:#027a48;font-size:12px;font-weight:bold;">
                      &#10003;&nbsp; PRESCRIPTION ISSUED
                    </span>
                  </td>
                </tr>
              </table>

              <!-- Prescription reference -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#f0f5ff;border:1px solid #dbe7ff;border-radius:12px;margin-bottom:28px;">
                <tr>
                  <td style="padding:20px 22px;">
                    <p style="margin:0 0 7px;color:#667085;font-size:11px;font-weight:bold;letter-spacing:1px;">
                      PRESCRIPTION REFERENCE
                    </p>
                    <p style="margin:0;color:#155eef;font-size:17px;font-weight:bold;word-break:break-word;">
                      <%= prescriptionId %>
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Doctor information -->
              <h2 style="margin:0 0 14px;color:#172b4d;font-size:17px;font-weight:bold;">
                Prescribed by your doctor
              </h2>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#ffffff;border:1px solid #e4e7ec;border-radius:12px;margin-bottom:30px;">
                <tr>
                  <td style="padding:20px 22px;">

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td valign="top" width="44">

                          <table role="presentation" cellpadding="0" cellspacing="0">
                            <tr>
                              <td align="center" valign="middle"
                                width="42" height="42"
                                style="background-color:#eaf1ff;border-radius:10px;color:#155eef;font-size:19px;font-weight:bold;">
                                &#10010;
                              </td>
                            </tr>
                          </table>

                        </td>

                        <td valign="middle" style="padding-left:12px;">

                          <p style="margin:0 0 5px;color:#172b4d;font-size:16px;font-weight:bold;">
                            Dr. <%= doctorName %>
                          </p>

                          <% if (specialization) { %>
                            <p style="margin:0 0 10px;color:#667085;font-size:13px;">
                              <%= specialization %>
                            </p>
                          <% } %>

                          <p style="margin:0;color:#667085;font-size:12px;line-height:1.7;">
                            Consultation date:
                            <strong style="color:#344054;">
                              <%= appointmentDate %>
                            </strong>
                          </p>

                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              <!-- Prescription details -->
              <h2 style="margin:0 0 7px;color:#172b4d;font-size:17px;font-weight:bold;">
                Prescription details
              </h2>

              <p style="margin:0 0 16px;color:#667085;font-size:13px;line-height:1.6;">
                Here is a summary of your prescription information.
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="border:1px solid #e4e7ec;border-radius:12px;overflow:hidden;margin-bottom:28px;">

                <tr>
                  <td width="42%" style="padding:15px 17px;background-color:#f8fafc;border-bottom:1px solid #e4e7ec;color:#667085;font-size:13px;">
                    Prescription ID
                  </td>
                  <td style="padding:15px 17px;border-bottom:1px solid #e4e7ec;color:#172b4d;font-size:13px;font-weight:bold;word-break:break-word;">
                    <%= prescriptionId %>
                  </td>
                </tr>

                <tr>
                  <td style="padding:15px 17px;background-color:#f8fafc;border-bottom:1px solid #e4e7ec;color:#667085;font-size:13px;">
                    Issued date
                  </td>
                  <td style="padding:15px 17px;border-bottom:1px solid #e4e7ec;color:#172b4d;font-size:13px;">
                    <%= issuedDate %>
                  </td>
                </tr>

                <tr>
                  <td style="padding:15px 17px;background-color:#f8fafc;color:#667085;font-size:13px;">
                    Follow-up date
                  </td>
                  <td style="padding:15px 17px;color:#172b4d;font-size:13px;font-weight:bold;">
                    <%= followUpDate || "As advised by your doctor" %>
                  </td>
                </tr>

              </table>

              <!-- Doctor instructions -->
              <% if (instructions) { %>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                  style="background-color:#eff6ff;border:1px solid #dbeafe;border-left:4px solid #155eef;border-radius:10px;margin-bottom:28px;">
                  <tr>
                    <td style="padding:20px 22px;">

                      <p style="margin:0 0 10px;color:#1d4ed8;font-size:14px;font-weight:bold;">
                        Important instructions from your doctor
                      </p>

                      <p style="margin:0;color:#344054;font-size:13px;line-height:1.9;white-space:pre-line;overflow-wrap:anywhere;">
                        <%= instructions %>
                      </p>

                    </td>
                  </tr>
                </table>

              <% } %>

              <!-- PDF action -->
              <% if (pdfUrl) { %>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                  style="margin:30px 0 18px;">
                  <tr>
                    <td align="center">

                      <a class="mobile-button"
                        href="<%= pdfUrl %>"
                        style="display:inline-block;background-color:#155eef;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;padding:16px 30px;border-radius:9px;line-height:1.4;">
                        &#128196;&nbsp; View Prescription PDF &nbsp;&#8594;
                      </a>

                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 28px;text-align:center;color:#98a2b3;font-size:12px;line-height:1.7;">
                  A PDF copy of your prescription is also attached to this email.
                </p>

              <% } %>

              <!-- Health reminder -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="border-top:1px solid #e4e7ec;">
                <tr>
                  <td style="padding-top:25px;">

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td valign="top" width="32">

                          <table role="presentation" cellpadding="0" cellspacing="0">
                            <tr>
                              <td width="28" height="28" align="center" valign="middle"
                                style="background-color:#fff7ed;border-radius:50%;color:#ea580c;font-size:15px;">
                                &#9888;
                              </td>
                            </tr>
                          </table>

                        </td>

                        <td valign="top" style="padding-left:10px;">

                          <p style="margin:0 0 7px;color:#344054;font-size:13px;font-weight:bold;">
                            A reminder for your health
                          </p>

                          <p style="margin:0;color:#667085;font-size:12px;line-height:1.9;">
                            Follow your doctor's instructions carefully.
                            If you have questions about your medication
                            or treatment, consult your healthcare provider.
                            Never change your prescribed treatment without
                            medical advice.
                          </p>

                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              <!-- Sign off -->
              <p style="margin:30px 0 5px;color:#344054;font-size:14px;line-height:1.7;">
                Wishing you good health,
              </p>

              <p style="margin:0;color:#155eef;font-size:15px;font-weight:bold;">
                Life Hospital Team
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="mobile-padding"
              style="padding:25px 36px;background-color:#f8fafc;border-top:1px solid #e4e7ec;text-align:center;">

              <p style="margin:0 0 8px;color:#344054;font-size:14px;font-weight:bold;">
                Life Hospital
              </p>

              <p style="margin:0 0 12px;color:#98a2b3;font-size:11px;line-height:1.8;">
                Your health, our priority.
              </p>

              <p style="margin:0;color:#98a2b3;font-size:11px;line-height:1.8;">
                This is an automated notification containing private
                health information. Please keep this email confidential
                and do not forward it to unauthorized individuals.
              </p>

              <p style="margin:15px 0 0;color:#b0b8c5;font-size:10px;">
                &copy; <%= new Date().getFullYear() %> Life Hospital. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>

  </table>

</body>
</html>
